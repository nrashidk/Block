# ---- Backend (server) ----
# Neon connection string. Neon dashboard -> your project -> Connect -> copy the
# "Pooled" connection string. Must include ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Any long random string. Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# Lets login work when the phone talks to the https Codespaces backend.
# Keep this true while developing in Codespaces.
CROSS_SITE_COOKIES=true

# Backend port (leave as-is)
PORT=5000

# ---- Client (Expo) ----
# The PUBLIC host of your backend, WITHOUT https:// and WITHOUT a trailing slash.
# In Codespaces this is your forwarded port-5000 URL, e.g.
#   turbo-spoon-xyz-5000.app.github.dev
EXPO_PUBLIC_DOMAIN=your-codespace-5000.app.github.dev

# Lets the mock in-app-purchase flow work while testing (no real payments)
MOCK_IAP_ENABLED=true

# Production only: comma-separated list of allowed browser origins for CORS.
# In production, ONLY these (and EXPO_PUBLIC_DOMAIN) are allowed.
ALLOWED_ORIGINS=https://your-production-domain.com
